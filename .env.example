# Copy to .env and edit. Nothing here is a guess about your hardware: blanks mean "not configured".

# --- Safety ---
# true = never send actuation commands (arm, seal, car). Telemetry may still be READ.
DRY_RUN=true
# Required for dashboard control buttons (E-STOP never needs it). Leave blank = controls disabled.
CONTROL_TOKEN=

# --- Camera: 0/1 = USB webcam index, or a URL (http://IP:port/stream), or a video file path ---
CAMERA_SOURCE=0
MODEL_PATH=models/best.pt
CONF_THRESHOLD=0.60

# --- Link to Arduino: none | serial | http ---
TRANSPORT=none
SERIAL_PORT=
BAUD_RATE=115200
HTTP_COMMAND_URL=
HTTP_TELEMETRY_URL=
COMM_TIMEOUT_S=5

# --- Existing Wi-Fi car (YOUR protocol; we only replay what you write here) ---
# Example only: CAR_URL_TEMPLATE=http://192.168.4.1/{cmd}   CAR_COMMANDS='{"forward":"F","reverse":"B","left":"L","right":"R","stop":"S"}'
CAR_URL_TEMPLATE=
CAR_COMMANDS=
# true = refuse to start the arm unless a car STOP was confirmed sent
CAR_STOP_REQUIRED=true

# --- Bin calibration, per bin, in cm (measure with the bin empty and full). 0 = uncalibrated -> level UNKNOWN ---
BIN1_EMPTY_CM=0
BIN1_FULL_CM=0
BIN2_EMPTY_CM=0
BIN2_FULL_CM=0
BIN3_EMPTY_CM=0
BIN3_FULL_CM=0
WARN_PCT=70
FULL_PCT=85
SENSOR_STALE_S=5
HAS_LOAD_CELL=false

# --- Moisture / metal ---
# Raw sensor value separating wet from dry. Blank = uncalibrated (cotton will be sent to manual inspection)
MOISTURE_WET_THRESHOLD=
# true if a HIGHER raw value means wetter (depends on your sensor/wiring)
MOISTURE_HIGH_IS_WET=true
REQUIRE_METAL_SENSOR=false
BLOCK_UNKNOWN_BIN=false
SEAL_COOLDOWN_S=300
DEPOSIT_TIMEOUT_S=5
